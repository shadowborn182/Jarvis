# ==============================================================================
# JARVIS — Advanced All-In-One Discord Management Bot
# Developer: Shadow
# Copy this file to .env and fill in real values. Never commit .env to git.
# ==============================================================================

# --- Discord Bot Credentials ---
DISCORD_TOKEN="YOUR_DISCORD_BOT_TOKEN"
DISCORD_CLIENT_ID="YOUR_DISCORD_APPLICATION_CLIENT_ID"
DISCORD_CLIENT_SECRET="YOUR_DISCORD_APPLICATION_CLIENT_SECRET"
BOT_OWNER_IDS="123456789012345678"

# --- Bot Behavior & Branding ---
DEFAULT_PREFIX="j!"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
SUPPORT_SERVER_URL="https://discord.gg/your-support-invite"
STATUS_ROTATION_SECONDS="30"

# --- Database Configuration ---
# Local Development (SQLite Async):
DATABASE_URL="sqlite+aiosqlite:///./database/jarvis.db"
# Production (PostgreSQL Async):
# DATABASE_URL="postgresql+asyncpg://jarvis_user:strong_password@localhost:5432/jarvis"
DB_POOL_SIZE="10"
DB_MAX_OVERFLOW="20"
DB_ECHO="false"

# --- Lavalink v4 Music Node ---
LAVALINK_URI="http://127.0.0.1:2333"
LAVALINK_PASSWORD="youshallnotpass"
LAVALINK_NODE_ID="jarvis-primary"

# --- FastAPI Web Dashboard ---
DASHBOARD_HOST="0.0.0.0"
DASHBOARD_PORT="8080"
DASHBOARD_BASE_URL="http://localhost:8080"
DISCORD_REDIRECT_URI="http://localhost:8080/auth/callback"
SESSION_SECRET="REPLACE_WITH_LONG_RANDOM_HEX_SECRET"
CSRF_SECRET="REPLACE_WITH_ANOTHER_LONG_RANDOM_HEX_SECRET"
